generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  EDITOR
}

enum EventCategory {
  ROUTINE
  FASTING
  VIGIL
  SPECIAL
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  role         UserRole @default(EDITOR)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Event {
  id          String         @id @default(cuid())
  title       String
  description String
  startDate   DateTime
  endDate     DateTime?
  location    String
  category    EventCategory
  isSpecial   Boolean        @default(false)
  image       String?
  createdAt   DateTime       @default(now())
  media       Media[]
}

model Media {
  id             String   @id @default(cuid())
  title          String
  url            String
  category       String
  eventId        String?
  event          Event?   @relation(fields: [eventId], references: [id], onDelete: SetNull)
  isFeaturedHome Boolean  @default(false)
  createdAt      DateTime @default(now())
}

model Article {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  content     String
  author      String
  coverImage  String?
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
}

model SiteSettings {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  updatedAt DateTime @updatedAt
}
